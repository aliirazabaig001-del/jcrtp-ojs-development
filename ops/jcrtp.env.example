# Copy to /root/jcrtp-ops/jcrtp.env on the VPS (NOT inside the web root, never
# commit it) and fill in every value from the discovery step (01-discover.sh).
# No credentials belong here: database credentials are read at run time from
# the live config.inc.php inside the container and are never printed.

# Directory containing the production docker-compose.yml
COMPOSE_DIR=/docker/jcrtp

# docker compose service names (see: docker compose ps --services)
APP_SERVICE=ojs
DB_SERVICE=db

# Database engine used by production: mysql | mariadb | postgres
DB_ENGINE=mysql

# OJS installation root inside the app container (contains config.inc.php)
OJS_ROOT=/var/www/html

# OJS files_dir inside the app container (from config.inc.php [files] files_dir)
OJS_FILES_DIR=/var/www/files

# How the theme reaches the container. If plugins/ (or the whole OJS root) is a
# bind mount, set THEME_HOST_DIR to the host path of
# plugins/themes/editorialjournal and leave THEME_VIA_DOCKER_CP=no.
# If the OJS code lives only inside the image, set THEME_VIA_DOCKER_CP=yes and
# read the persistence warning in DEPLOYMENT.md first.
THEME_HOST_DIR=/docker/jcrtp/ojs/plugins/themes/editorialjournal
THEME_VIA_DOCKER_CP=no

# Web server user inside the container (owner of OJS files)
WEB_USER=www-data

# Where backups are written on the VPS (outside any web root)
BACKUP_ROOT=/root/jcrtp-backups

# Public base URL used by the smoke test (journal path included)
SITE_URL=https://jcrtp.com/index.php/jcrtp
